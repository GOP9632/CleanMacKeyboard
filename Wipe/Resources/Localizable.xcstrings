    "settings.timeout.footnote" : {
      "comment" : "逾時底下的說明。必須寫明它關不掉，以及為什麼（見 ADR-0002）。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be turned off, and fifteen minutes is as long as it goes. Your keyboard does nothing while cleaning mode is on, so if the unlock gesture ever fails to register, this countdown is the way back."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一項關不掉，最長也只到 15 分鐘。清潔模式期間鍵盤是失效的，萬一解鎖手勢認不出來，這個倒數就是你回得去的那條路。"
          }
        }
      }
    },
    "settings.timeout.title" : {
      "comment" : "逾時自動解除的選單標題。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock automatically after"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動解除時間"
          }
        }
      }
    },
    "settings.unlock.footnote" : {
      "comment" : "解鎖手勢底下的說明。順帶說明第三顆按鍵會重新計時，而且那一條沒有開關。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the left and right Command keys together for this long to leave cleaning mode. Longer is safer against a stray cloth, shorter is easier on your hands. Any third key pressed during the hold restarts the count, which is what keeps a cloth from unlocking Wipe, and that part cannot be turned off."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時按住左右兩顆 Command 鍵這麼久，就會離開清潔模式。設久一點，抹布誤解鎖的機會更低；設短一點，自己解鎖更輕鬆。按住期間只要出現第三顆按鍵就會重新計時，那正是抹布解不開 Wipe 的原因，所以它沒有開關。"
          }
        }
      }
    },
    "settings.unlock.hold" : {
      "comment" : "解鎖手勢要按住多久，右邊接著秒數。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold both Command keys for"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖手勢按住"
          }
        }
      }
    }
