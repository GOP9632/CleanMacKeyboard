{
  "sourceLanguage" : "en",
  "strings" : {
    "app.name" : {
      "comment" : "產品名稱，兩種語言都不翻。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe"
          }
        }
      }
    },
    "authorization.autoDetect" : {
      "comment" : "授權引導畫面底下的說明，告訴使用者打完勾不必重開 app。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave Wipe open. It notices the moment you turn it on, and this screen becomes the ring again."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe 開著就好。你一打開授權它就會發現，這個畫面會自己變回圓環。"
          }
        }
      }
    },
    "authorization.capability" : {
      "comment" : "授權引導畫面上誠實說明這個授權讓 Wipe 拿到什麼能力。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility lets Wipe see every keystroke, click, and trackpad gesture on this Mac, and discard them before any app receives them."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助使用授權讓 Wipe 看得到這台 Mac 上的每一次按鍵、點擊與觸控板動作，並且在其他 app 收到之前把它們丟掉。"
          }
        }
      }
    },
    "authorization.openSettings" : {
      "comment" : "授權引導畫面上那顆按鈕，按了直接開啟系統設定的對應頁面。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟系統設定"
          }
        }
      }
    },
    "authorization.promise" : {
      "comment" : "授權引導畫面上說明 Wipe 拿這個授權做什麼、不做什麼。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe only discards events while cleaning mode is on. It never records what you type, never stores it, and never sends anything anywhere."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe 只在清潔模式期間把事件丟掉。它不記錄你打了什麼，不存下來，也不會傳到任何地方。"
          }
        }
      }
    },
    "authorization.steps" : {
      "comment" : "授權引導畫面上的操作步驟，要講明是哪個授權、去哪裡打勾。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings, go to Privacy & Security › Accessibility, and turn on Wipe."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開「系統設定」，到「隱私權與安全性 › 輔助使用」，把 Wipe 打開。"
          }
        }
      }
    },
    "authorization.title" : {
      "comment" : "授權引導畫面的標題。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe needs your permission"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe 需要你的授權"
          }
        }
      }
    },
    "diagnostics.headline" : {
      "comment" : "診斷視窗的標題行，說明這個畫面要回答什麼問題。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can Wipe tell the two Command keys apart?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe 分得出左右兩顆 Command 嗎？"
          }
        }
      }
    },
    "diagnostics.instructions" : {
      "comment" : "診斷視窗的操作說明。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this window in front, then hold the left Command key and watch which light comes on. Repeat with the right one."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓這個視窗留在最前面，按住左邊的 Command，看哪一顆燈亮起來。再用右邊的按一次。"
          }
        }
      }
    },
    "diagnostics.left.command" : {
      "comment" : "左 Command 指示燈的名稱。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left Command"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左 Command"
          }
        }
      }
    },
    "diagnostics.log.clear" : {
      "comment" : "清空診斷紀錄的按鈕。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空"
          }
        }
      }
    },
    "diagnostics.log.copy" : {
      "comment" : "把整份診斷紀錄複製起來的按鈕，用途是貼回票上。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製"
          }
        }
      }
    },
    "diagnostics.log.count" : {
      "comment" : "診斷紀錄目前的筆數與上限。第一個數字是筆數，第二個是上限。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld entries kept"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留 %1$lld 筆，上限 %2$lld 筆"
          }
        }
      }
    },
    "diagnostics.log.empty" : {
      "comment" : "診斷紀錄還是空的時候顯示的文字。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No keyboard events yet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有收到任何鍵盤事件。"
          }
        }
      }
    },
    "diagnostics.passthrough.note" : {
      "comment" : "說明診斷畫面只讀取事件，不攔截也不修改。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This window only reads keyboard events while Wipe is in front. It never blocks or changes them, and it needs no system permission."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個視窗只在 Wipe 位於前景時讀取鍵盤事件。它不攔截也不修改任何事件，也不需要任何系統授權。"
          }
        }
      }
    },
    "diagnostics.right.command" : {
      "comment" : "右 Command 指示燈的名稱。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right Command"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右 Command"
          }
        }
      }
    },
    "diagnostics.state.down" : {
      "comment" : "指示燈的狀態：這顆鍵正被按著。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Held down"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按著"
          }
        }
      }
    },
    "diagnostics.state.up" : {
      "comment" : "指示燈的狀態：這顆鍵沒有被按著。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Released"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放開"
          }
        }
      }
    },
    "diagnostics.window.title" : {
      "comment" : "診斷視窗的標題，也是它在「視窗」選單裡的名稱。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard diagnostics"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤診斷"
          }
        }
      }
    },
    "main.refusal.interceptionUnavailable" : {
      "comment" : "拒絕進入清潔模式的理由：授權已經給了，攔截還是建立不起來。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe has permission but still cannot block input. Quit Wipe and open it again."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe 拿到授權了，還是建立不了攔截。請結束 Wipe 再重新開啟。"
          }
        }
      }
    },
    "main.refusal.secureInput" : {
      "comment" : "拒絕進入清潔模式的理由：安全輸入模式啟動中，但查不出是哪個 app 造成的。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure input is on, so Wipe cannot block the keyboard."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全輸入模式啟動中，Wipe 攔不住鍵盤。"
          }
        }
      }
    },
    "main.refusal.secureInput.app" : {
      "comment" : "拒絕進入清潔模式的理由，%@ 是造成安全輸入模式的 app 名稱。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ turned on secure input, so Wipe cannot block the keyboard."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 啟動了安全輸入模式，Wipe 攔不住鍵盤。"
          }
        }
      }
    },
    "main.scope.allInput" : {
      "comment" : "清潔模式期間顯示目前的攔截範圍是全輸入鎖。範圍的名字加上它的代價：游標也停住，所以沒有滑鼠可以求救。必須短到只佔一行，長度有測試量著（見 SecondaryLineLayoutTests）。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All input locked, pointer frozen"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全輸入鎖，游標也停住"
          }
        }
      }
    },
    "main.scope.keyboard" : {
      "comment" : "清潔模式期間顯示目前的攔截範圍是鍵盤鎖。範圍的名字加上那條還留著的求救路徑。必須短到只佔一行，長度有測試量著（見 SecondaryLineLayoutTests）。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard locked, trackpad works"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤鎖，觸控板仍然可用"
          }
        }
      }
    },
    "main.timeout.remaining" : {
      "comment" : "清潔模式期間顯示的逾時剩餘時間，%@ 是 分:秒。刻意放在圓環外面，不佔用圓環。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-unlocks in %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 後自動解除"
          }
        }
      }
    },
    "ring.cleaning.title" : {
      "comment" : "清潔模式期間圓環中央的文字。排版寬度以英文長度為基準。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cleaning"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清潔中"
          }
        }
      }
    },
    "ring.preparing.seconds" : {
      "comment" : "緩衝倒數的剩餘秒數，顯示在圓環中央標題底下。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld s"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 秒"
          }
        }
      }
    },
    "ring.preparing.title" : {
      "comment" : "準備清潔期間圓環中央的文字，此時還沒開始攔截。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get ready"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備清潔"
          }
        }
      }
    },
    "ring.standby.title" : {
      "comment" : "待命時圓環中央的文字。這是最長的英文中央文字，圓環的文字寬度以它為準。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start cleaning"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始清潔"
          }
        }
      }
    },
    "settings.buffer.footnote" : {
      "comment" : "準備清潔緩衝底下的說明，講這段倒數是留來做什麼的。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The countdown is your window to take your hands off the keyboard and pick up the cloth. Turn it off once you no longer need it."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段倒數是留給你把手離開鍵盤、拿起抹布的時間。熟練之後可以關掉，按下開始就直接進入清潔模式。"
          }
        }
      }
    },
    "settings.buffer.length" : {
      "comment" : "準備清潔緩衝的長度，右邊接著秒數。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdown"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倒數長度"
          }
        }
      }
    },
    "settings.buffer.toggle" : {
      "comment" : "準備清潔緩衝的開關。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count down before locking"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖上之前先倒數"
          }
        }
      }
    },
    "settings.presentation.footnote" : {
      "comment" : "畫面呈現底下的說明，講兩個選項各自的用途。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main window keeps its size and position and simply comes to the front while cleaning. The overlay also hides your work from the room, and its dark background makes the dust on the screen easy to see."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主視窗維持原本的大小和位置，清潔模式期間暫時置頂。遮蔽層還會擋住旁人的視線，深色底也讓螢幕上的灰塵看得見。"
          }
        }
      }
    },
    "settings.presentation.mainWindow" : {
      "comment" : "畫面呈現的第一個選項：只有原本那個視窗。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main window"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主視窗"
          }
        }
      }
    },
    "settings.presentation.overlay" : {
      "comment" : "畫面呈現的第二個選項：每個螢幕鋪一層深色畫面。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark overlay on every display"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮蔽層蓋滿每一個螢幕"
          }
        }
      }
    },
    "settings.presentation.title" : {
      "comment" : "畫面呈現的選單標題。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On screen"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫面呈現"
          }
        }
      }
    },
    "settings.scope.allInput" : {
      "comment" : "攔截範圍的第二個選項：連觸控板與滑鼠一起攔截。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard, trackpad and mouse"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全輸入鎖（連觸控板與滑鼠）"
          }
        }
      }
    },
    "settings.scope.footnote" : {
      "comment" : "攔截範圍底下的說明，講兩個選項各自的取捨。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard only leaves the trackpad working, so there is always a way to ask for help that does not go through the keyboard. Locking everything lets you clean the palm rest and the trackpad too, at the cost of that escape route."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤鎖保留觸控板，永遠留著一條不靠鍵盤的求救路徑。全輸入鎖連掌托和觸控板都能放心擦，代價是少了那條路。"
          }
        }
      }
    },
    "settings.scope.keyboard" : {
