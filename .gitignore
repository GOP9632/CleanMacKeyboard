# ============================================
# 敏感資料（最重要，絕對不要上傳）
# ============================================

# 環境變數與設定檔
.env
.env.*
!.env.example
*.env

# 金鑰、憑證、密碼
*.pem
*.key
*.p12
*.pfx
*.cer
*.der
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
secrets.*
Secrets.*
credentials.*
*_credentials.json
*-credentials.json
serviceAccount*.json
apikeys.*
APIKeys.*

# Apple 開發者相關
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
*.xcuserstate

# SSH / GPG
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.gpg
*.asc

# ============================================
# macOS 系統檔
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Thumbs.db

