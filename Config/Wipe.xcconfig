// Wipe app target 的設定。
//
// 這個檔案刻意不 #include Common.xcconfig。專案層已經套了
// Debug.xcconfig / Release.xcconfig，而那兩個檔案各自 #include 了 Common。
// target 層的設定優先於專案層，所以這裡只寫 target 自己的事，
// 不要把共用設定再抄一份進來，否則哪天 Common 多了一個 Debug 想覆蓋的設定，
// 就會被 target 層無聲地蓋回去。

// 產品名稱是 Wipe，repo 名稱 CleanMacKeyboard 只是專案代號。
PRODUCT_NAME = Wipe
PRODUCT_MODULE_NAME = Wipe

// bundle 識別碼不可隨意更動。macOS 的「輔助使用」授權是綁在 bundle ID 加簽章
// 上的，改了就等於變成另一個 app，使用者必須重新授權。
PRODUCT_BUNDLE_IDENTIFIER = com.anthonyliu.wipe

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright =

// 這一版刻意「不」設定 LSUIElement。Wipe 是一個普通的 app 視窗，
// 沒有選單列常駐圖示（見 #1 的 Out of Scope）。
// 如果哪天要做選單列圖示，那是另一張票，不是在這裡偷偷加一行。

// === 強調色：固定青色，不跟隨系統強調色 ===
// 這一行是「不跟隨系統強調色」真正生效的地方，見
// docs/adr/0003-fixed-accent-colour.md。macOS 的控制項預設會用使用者在
// 系統設定裡選的強調色，只有指定 app 自己的全域強調色資源才蓋得掉。
// 光在個別視圖上寫 tint 是不夠的：漏掉的地方就會退回系統強調色，
// 而那正好會讓「清潔中」跟「攔截失效」或「準備清潔」同色。
// AccentColor 的色值必須與 CleaningCyan 一致，有測試守著。
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// app 圖示是另一張票（T14，#15）。在那之前刻意不指定
// ASSETCATALOG_COMPILER_APPICON_NAME，先用系統預設圖示，
// 這樣資源目錄裡不需要放一個空的 appiconset。

// 本地化：英文是開發語言，繁體中文由字串目錄提供，介面跟隨系統語言。
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

COMBINE_HIDPI_IMAGES = YES
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
