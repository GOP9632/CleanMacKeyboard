// Wipe 的共用建置設定。
//
// 這些設定放在 xcconfig 而不是 project.pbxproj 裡，理由是有幾項設定必須附上
// 「為什麼」，而 Xcode 每次改動設定都會重寫 project.pbxproj 並丟掉裡面的註解。

// =============================================================
// 沙盒：必須維持關閉，而且不可以被打開
// =============================================================
// Wipe 的核心功能是在清潔模式期間用 CGEventTap 丟棄鍵盤與觸控板事件，
// 沙盒禁止這個等級的輸入攔截。把它打開不會有編譯錯誤，app 會照樣啟動，
// 但攔截會完全失效，也就是「畫面顯示清潔中、鍵盤其實還活著」這種最危險
// 的失效方式。詳見 docs/adr/0001-event-tap-over-app-store.md。
//
// 這同時代表 Wipe 不可能上 Mac App Store。那是已經做完的取捨，不是待辦事項，
// 所以任何「順手把沙盒打開比較乾淨」的整理都應該被退回。
ENABLE_APP_SANDBOX = NO

// =============================================================
// 平台
// =============================================================
// 最低支援 macOS 14。Wipe 沒有用到任何更新的 API，往下支援的成本接近零。
MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = $(ARCHS_STANDARD)

// =============================================================
// 簽章
// =============================================================
// 用一張自簽的憑證，不是 ad-hoc（Xcode 介面上的 Sign to Run Locally）。
//
// 理由是 macOS 的「輔助使用」授權綁在簽章身分上，而 ad-hoc 簽章每次重新編譯
// 都會換一枚新的，系統會把重編後的 Wipe 當成沒見過的 app，先前打的勾對它
// 無效。接上真正的攔截之後，那會讓每一次除錯都伴隨「明明授權過了卻沒作用」。
//
// 這張憑證要自己建一次，步驟寫在 #10 上。新的機器或重灌之後拿不到憑證，
// 編譯會失敗並指名找不到這個身分，那就是回去照那份步驟再建一張。
//
// 對外分發要換成 Apple 發的 Developer ID 憑證加公證，自簽的擋不掉 Gatekeeper。
// 目前純自用，見 ADR-0001。
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Wipe Self-Signed
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES

// =============================================================
// Swift 與編譯
// =============================================================
SWIFT_VERSION = 5.0
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
ALWAYS_SEARCH_USER_PATHS = NO

// 警告設定。這個專案的失效模式很貴，寧可編譯期囉唆一點。
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES
GCC_NO_COMMON_BLOCKS = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES

// =============================================================
// 版本
// =============================================================
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
